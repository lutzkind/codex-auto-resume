<?xml version="1.0" encoding="UTF-8"?>
<!--
  Reference copy only. This document is UTF-8 for readability; the generated
  file that `schtasks /create /xml` consumes is written as UTF-16 with a BOM.

  `codex-auto-resume install-service` generates the real task definition under
  %LOCALAPPDATA%\codex-auto-resume\service\codex-auto-resume-helper.xml
  (UTF-16, as schtasks /create /xml requires) with the absolute paths of your
  interpreter, launcher and Codex binary baked in, plus the state directory the
  helper must use. This file documents the shape of that XML; it is not
  installed verbatim.

  Semantics, mirrored from the systemd unit:
    LogonTrigger                = WantedBy=default.target (starts at logon)
    RestartOnFailure            = Restart=on-failure
    ExecutionTimeLimit PT0S     = a long wait is never cut short
    InteractiveToken, LeastPrivilege = a normal user task, no administrator
-->
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>codex-auto-resume helper: wait for the Codex quota reset and resume the exact session.</Description>
    <URI>\codex-auto-resume-helper</URI>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
      <UserId>DESKTOP\you</UserId>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>DESKTOP\you</UserId>
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>7</Priority>
    <RestartOnFailure>
      <Interval>PT1M</Interval>
      <Count>10</Count>
    </RestartOnFailure>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>C:\Program Files\Python312\python.exe</Command>
      <Arguments>"C:\Users\you\codex-auto-resume\bin\codex-auto-resume" helper --state-dir "C:\Users\you\AppData\Local\codex-auto-resume" --codex-bin "C:\Users\you\AppData\Local\Programs\OpenAI\Codex\bin\codex.exe"</Arguments>
    </Exec>
  </Actions>
</Task>
